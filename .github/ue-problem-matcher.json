{
  "problemMatcher": [
    {
      "owner": "ue-msvc-error",
      "severity": "error",
      "pattern": [
        {
          "regexp": "^(?:\\s*\\d+>)?\\s*(.+?)\\((\\d+)(?:,(\\d+))?\\)\\s*:\\s*(?:fatal\\s+)?error\\s+(?!MSB\\d)([A-Za-z]+\\d+)\\s*:\\s*(.+)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "code": 4,
          "message": 5
        }
      ]
    },
    {
      "owner": "ue-msvc-warning",
      "severity": "warning",
      "pattern": [
        {
          "regexp": "^(?:\\s*\\d+>)?\\s*(.+?)\\((\\d+)(?:,(\\d+))?\\)\\s*:\\s*(?:fatal\\s+)?warning\\s+(?!MSB\\d)([A-Za-z]+\\d+)\\s*:\\s*(.+)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "code": 4,
          "message": 5
        }
      ]
    },
    {
      "owner": "ue-msvc-note",
      "severity": "notice",
      "pattern": [
        {
          "regexp": "^(?:\\s*\\d+>)?\\s*(.+?)\\((\\d+)(?:,(\\d+))?\\)\\s*:\\s*note\\s*:\\s*(.+)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "message": 4
        }
      ]
    },
    {
      "owner": "ue-ubt-buildenv",
      "severity": "error",
      "pattern": [
        {
          "regexp": "^(?:\\s*\\d+>)?\\s*(\\S+ modifies the values of properties: .+)$",
          "message": 1
        }
      ]
    },
    {
      "owner": "ue-ubt-exec-error",
      "severity": "error",
      "pattern": [
        {
          "regexp": "^(?:\\s*\\d+>)?\\s*EXEC\\s*:\\s*error\\s*:\\s*(?!\\s*\\[Upgrade\\])(.+)$",
          "message": 1
        }
      ]
    },
    {
      "owner": "ue-ubt-exec-warning",
      "severity": "warning",
      "pattern": [
        {
          "regexp": "^(?:\\s*\\d+>)?\\s*EXEC\\s*:\\s*warning\\s*:\\s*(?!\\s*\\[Upgrade\\])(.+)$",
          "message": 1
        }
      ]
    },
    {
      "owner": "ue-uht-error",
      "severity": "error",
      "pattern": [
        {
          "regexp": "^(?:\\s*\\d+>)?\\s*(.+?)\\((\\d+)(?:,(\\d+))?\\)\\s*:\\s*[Ee]rror\\s*:\\s*(.+)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "message": 4
        }
      ]
    },
    {
      "owner": "ue-uht-warning",
      "severity": "warning",
      "pattern": [
        {
          "regexp": "^(?:\\s*\\d+>)?\\s*(.+?)\\((\\d+)(?:,(\\d+))?\\)\\s*:\\s*[Ww]arning\\s*:\\s*(.+)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "message": 4
        }
      ]
    },
    {
      "owner": "ue-linker-error",
      "severity": "error",
      "pattern": [
        {
          "regexp": "^(?:\\s*\\d+>)?\\s*(?:.+?)\\s:\\s(?:fatal\\s+)?error\\s+(LNK\\d+)\\s*:\\s*(.+)$",
          "code": 1,
          "message": 2
        }
      ]
    },
    {
      "owner": "ue-linker-warning",
      "severity": "warning",
      "pattern": [
        {
          "regexp": "^(?:\\s*\\d+>)?\\s*(?:.+?)\\s:\\s(?:fatal\\s+)?warning\\s+(LNK\\d+)\\s*:\\s*(.+)$",
          "code": 1,
          "message": 2
        }
      ]
    },
    {
      "owner": "ue-msbuild-error",
      "severity": "error",
      "pattern": [
        {
          "regexp": "^(?:\\s*\\d+>)?.*?\\berror\\s+(MSB\\d+)\\s*:\\s*(.+)$",
          "code": 1,
          "message": 2
        }
      ]
    },
    {
      "owner": "ue-msbuild-warning",
      "severity": "warning",
      "pattern": [
        {
          "regexp": "^(?:\\s*\\d+>)?.*?\\bwarning\\s+(MSB\\d+)\\s*:\\s*(.+)$",
          "code": 1,
          "message": 2
        }
      ]
    }
  ]
}
